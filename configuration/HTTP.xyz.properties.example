# Copy to HTTP.xyz.properties and replace the placeholders.
# UTF-8 key=value; values are literal, without quotes.
endpoint=http://127.0.0.1:8000/http/REPLACE_WITH_REMOTE_CONNECTION_ID
token=REPLACE_WITH_TOKEN
send_method=PUT
enable_inbound=true
inbound_token=REPLACE_WITH_INBOUND_TOKEN
inbound_only=false
