{
  "name": "Sample LDAP directory",
  "protocol": "LDAP",
  "endpoint": "ldaps://directory.example:636",
  "config": {
    "directory_type": "LDAP directory",
    "bind_dn": "CN=relay-sync,OU=Services,DC=example,DC=com",
    "password_env": "LDAP_SYNC_PASSWORD",
    "base_dn": "OU=People,DC=example,DC=com",
    "search_filter": "(objectClass=person)",
    "username_attribute": "sAMAccountName",
    "email_attribute": "mail",
    "uid_attribute": "objectGUID",
    "start_tls": true
  }
}
